# Server
PORT=3000
NODE_ENV=development

# ---------------------------------------------------------------------------
# Database
# Default: local SQLite (no setup needed, stored in ./data/ecoinventory.db)
# For PostgreSQL: create a database, run schema.sql against it, and set
# DATABASE_URL below (individual PG_* vars are also supported).
# ---------------------------------------------------------------------------
DATABASE_TYPE=sqlite
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/ecoinventory

# PostgreSQL connection (used when DATABASE_URL is not set and
# DATABASE_TYPE=postgres). Ignored when DATABASE_URL is provided.
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=ecoinventory
PG_USER=postgres
PG_PASSWORD=postgres

# ---------------------------------------------------------------------------
# Auth — optional during development; required when NODE_ENV=production.
# Generate a strong value with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# ---------------------------------------------------------------------------
JWT_SECRET=

# Public base URL encoded into product QR codes (no trailing slash).
# Defaults to the current request's address when unset (works in CodeSandbox).
BASE_URL=
